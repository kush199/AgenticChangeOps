{
  "openapi": "3.0.1",
  "info": {
    "title": "AgenticChangeOps change request API",
    "description": "Local-only JSON API over the intake, approval, requirements drafting and design drafting capabilities. No authentication. Error bodies carry a code: invalid-body (400), validation-failed (400), invalid-identifier (400), invalid-host (400), not-found (404), no-draft (404), no-design-draft (404), route-not-found (404), method-not-allowed (405), conflict (409), body-too-large (413), unsupported-media-type (415), generation-failed (502, with only a category), drafting-not-configured (503), design-not-configured (503), unexpected-error (500).",
    "version": "v1"
  },
  "paths": {
    "/change-requests": {
      "post": {
        "tags": [
          "ChangeRequestEndpoints"
        ],
        "summary": "Submit a change request",
        "operationId": "SubmitChangeRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitChangeRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeRequest"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
